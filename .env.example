# Plantilla de configuración. Copiar a `.env` y completar.
# El `.env` NUNCA se commitea; este archivo (.env.example) SÍ, pero sin
# valores reales.

# ---------------------------------------------------------------------------
# OBLIGATORIA SIEMPRE
# ---------------------------------------------------------------------------
# Clave con la que se firman las sesiones. Sin esto la app no arranca.
# Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
# Postgres. Obligatoria en producción y SIEMPRE en Render (el disco de Render
# es efímero: con SQLite los datos se pierden en cada deploy).
# Formato: postgresql://usuario:password@host/basededatos?sslmode=require
DATABASE_URL=

# Solo desarrollo local: archivo SQLite que se usa cuando DATABASE_URL está
# vacía. Relativo al directorio del proyecto.
DATABASE=pacientes.db

# Usada SOLO por scripts/backup_db.py, para backupear la base de PRODUCCIÓN
# desde una máquina local sin que la app local deje de usar SQLite.
BACKUP_DATABASE_URL=

# ---------------------------------------------------------------------------
# ACCESO
# ---------------------------------------------------------------------------
# El ingreso NO tiene contraseña: se entra con nombre y apellido + DNI, y
# quien entra puede cargar investigaciones y modificar las suyas.
# Acá van los DNIs que además pueden BORRAR registros del repositorio.
# Separados por coma. Se aceptan puntos (se limpian solos). Puede ir vacía.
ADMIN_DNIS=

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
# True solo en desarrollo (hot reload y errores en pantalla). En producción: False.
DEBUG=False
HOST=0.0.0.0
PORT=5000
